# Copie este arquivo para .env.local e preencha com os dados públicos do projeto.
# Nunca coloque a chave service_role ou segredos das redes sociais aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL
# Mantenha false enquanto o aplicativo TikTok não concluir a auditoria de Direct Post.
NEXT_PUBLIC_TIKTOK_AUDITED=false
